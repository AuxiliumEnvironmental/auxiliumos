{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auxilium Spatial derivative-only drawing pages manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileVersion",
    "documentID",
    "floorID",
    "revision",
    "measurementStatus",
    "format",
    "pageCount",
    "files"
  ],
  "properties": {
    "profileVersion": {
      "const": "auxilium-spatial-drawing-pages/1.0.0"
    },
    "documentID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "floorID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "measurementStatus": {
      "const": "unverified"
    },
    "format": {
      "enum": [
        "svg",
        "png"
      ]
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mimeType",
          "sha256",
          "bytes",
          "pageIndex"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^floorplan-[0-9]{4}\\.(svg|png)$"
          },
          "mimeType": {
            "enum": [
              "image/svg+xml",
              "image/png"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "pageIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 499
          }
        }
      }
    }
  }
}
