{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auxilium Spatial local document manifest 1.1.0 (recoverable source provenance)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileVersion",
    "documentID",
    "revision",
    "measurementStatus",
    "coordinateSystem",
    "floors",
    "files"
  ],
  "properties": {
    "profileVersion": {
      "const": "auxilium-spatial-local-document/1.1.0"
    },
    "documentID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "measurementStatus": {
      "const": "unverified"
    },
    "coordinateSystem": {
      "const": "meters_y_up_right_handed"
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "floorID",
          "label",
          "elevation",
          "index",
          "pageCount",
          "representationStatus"
        ],
        "properties": {
          "floorID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "elevation": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "representationStatus": {
            "enum": [
              "empty",
              "geometry"
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 7,
      "maxItems": 4095,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mimeType",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(geometry\\.json|source/(geometry|identity)\\.json|floors/[0-9]{4}/(scene\\.json|model\\.glb|floorplan\\.pdf|floorplan-[0-9]{4}\\.(svg|png)))$"
          },
          "mimeType": {
            "enum": [
              "application/json",
              "application/pdf",
              "image/svg+xml",
              "image/png",
              "model/gltf-binary"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "floorID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "pageIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 499
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "path": {
                "const": "source/geometry.json"
              },
              "mimeType": {
                "const": "application/json"
              }
            },
            "required": [
              "path",
              "mimeType"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "floorID"
                  ]
                },
                {
                  "required": [
                    "pageIndex"
                  ]
                }
              ]
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "path": {
                "const": "source/identity.json"
              },
              "mimeType": {
                "const": "application/json"
              }
            },
            "required": [
              "path",
              "mimeType"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "floorID"
                  ]
                },
                {
                  "required": [
                    "pageIndex"
                  ]
                }
              ]
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
