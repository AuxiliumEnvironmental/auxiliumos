{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "documentID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "floorID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "faces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "objectID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "role": {
            "enum": [
              "wall",
              "floor"
            ]
          },
          "vertices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                "y": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                "z": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            },
            "minItems": 3,
            "maxItems": 1000
          },
          "triangles": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "objectID",
          "role",
          "vertices",
          "triangles"
        ]
      },
      "minItems": 0,
      "maxItems": 200000
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "objectID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "role": {
            "enum": [
              "wall",
              "window",
              "area",
              "door",
              "passage"
            ]
          },
          "a": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "y": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "z": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ]
          },
          "b": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "y": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "z": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ]
          }
        },
        "required": [
          "objectID",
          "role",
          "a",
          "b"
        ]
      },
      "minItems": 0,
      "maxItems": 400000
    }
  },
  "required": [
    "schemaVersion",
    "documentID",
    "revision",
    "floorID",
    "faces",
    "edges"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auxilium:spatial:graphic-scene:1.1.0"
}
