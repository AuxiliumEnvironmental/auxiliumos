{
  "version": 1,
  "rule": "Static profiles cannot prove database/API/browser behavior. Add meaningful runtime profiles with explicit environment identity and required evidence levels as modules are implemented. Inputs cover every file/test/config affecting the claim. Review input coverage when architecture changes.",
  "profiles": [
    {
      "id": "controls",
      "level": "control_unit",
      "environment": "local-node-control-tests",
      "cacheable": true,
      "timeout_ms": 120000,
      "inputs": [
        "AGENTS.md",
        "BUILD_STATE.json",
        "BUILD_QUEUE.json",
        "REQUIREMENTS.json",
        "OWNER_DECISIONS.json",
        "config",
        "scripts",
        "tests/unit/control-system.test.mjs",
        "docs",
        ".cursor",
        ".codex",
        ".github",
        "tests/unit/document-integrity.test.mjs"
      ],
      "commands": [
        [
          "node",
          "scripts/os-control.mjs",
          "validate"
        ],
        [
          "node",
          "scripts/check-docs.mjs"
        ],
        [
          "node",
          "--test",
          "tests/unit/control-system.test.mjs",
          "tests/unit/document-integrity.test.mjs"
        ]
      ],
      "include_root_files": true,
      "environment_variables": [
        "GIT_CONFIG_GLOBAL",
        "GIT_CONFIG_SYSTEM",
        "GIT_CONFIG_NOSYSTEM"
      ]
    },
    {
      "id": "foundation-contract",
      "level": "static_sql_contract",
      "environment": "local-node-sql-text-only",
      "cacheable": true,
      "timeout_ms": 120000,
      "inputs": [
        "supabase/migrations",
        "supabase/seed",
        "tests/unit/foundation-migration-contract.test.mjs"
      ],
      "commands": [
        [
          "node",
          "--test",
          "tests/unit/foundation-migration-contract.test.mjs"
        ]
      ]
    },
    {
      "id": "package-importer",
      "level": "control_unit",
      "environment": "local-node-isolated-git-fixtures",
      "environment_variables": [
        "GIT_CONFIG_GLOBAL",
        "GIT_CONFIG_SYSTEM",
        "GIT_CONFIG_NOSYSTEM"
      ],
      "cacheable": true,
      "timeout_ms": 120000,
      "inputs": [
        "tools/package-importer"
      ],
      "commands": [
        [
          "node",
          "--test",
          "tools/package-importer/tests/apply-package.test.mjs"
        ]
      ]
    },
    {
      "id": "source-reconciliation",
      "level": "source_inspection",
      "environment": "live-github-read-and-recorded-connector-observations",
      "cacheable": false,
      "timeout_ms": 30000,
      "inputs": [
        "scripts/verify-source-reconciliation.mjs",
        "docs/00-control/SOURCE_RECONCILIATION.json",
        "supabase/migrations/20260713000100_foundation_slice_schema.sql"
      ],
      "commands": [
        [
          "node",
          "scripts/verify-source-reconciliation.mjs"
        ]
      ],
      "max_age_ms": 900000
    },
    {
      "id": "directory-database",
      "level": "database",
      "environment": "local-PostgreSQL-18.3-PGlite-0.5.8-with-simulated-Auth-claims",
      "cacheable": true,
      "timeout_ms": 120000,
      "inputs": [
        "supabase/migrations",
        "supabase/seed",
        "tests/database",
        "tests/helpers"
      ],
      "commands": [
        [
          "node",
          "--test",
          "tests/database/identity-directory.test.mjs"
        ]
      ]
    },
    {
      "id": "runtime-build",
      "level": "build",
      "environment": "local-Node-24-TypeScript-Vite-production-bundle",
      "cacheable": true,
      "timeout_ms": 120000,
      "inputs": [
        "web",
        "tests/unit/runtime-configuration.test.mjs",
        "tests/unit/auth-persistence.test.mjs"
      ],
      "commands": [
        [
          "npm",
          "run",
          "build"
        ],
        [
          "node",
          "--test",
          "tests/unit/runtime-configuration.test.mjs",
          "tests/unit/auth-persistence.test.mjs"
        ]
      ],
      "environment_variables": [
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_PUBLISHABLE_KEY",
        "VITE_ALLOW_LOCAL_TEST_BACKEND"
      ]
    },
    {
      "id": "directory-browser-fixture",
      "level": "browser_fixture",
      "environment": "local-Chromium-React-Supabase-SDK-intercepted-HTTP-no-cloud",
      "cacheable": true,
      "timeout_ms": 120000,
      "environment_variables": [
        "AUXILIUMOS_BROWSER_EXECUTABLE"
      ],
      "inputs": [
        "web",
        "tests/e2e/directory.spec.ts",
        "playwright.runtime.config.ts"
      ],
      "commands": [
        [
          "npm",
          "run",
          "test:runtime-ui"
        ]
      ]
    },
    {
      "id": "directory-api",
      "level": "api",
      "environment": "authentic-Supabase-development-Auth-and-Data-API-securely-configured-target",
      "cacheable": false,
      "max_age_ms": 900000,
      "timeout_ms": 300000,
      "environment_variables": [
        "AUXILIUMOS_TEST_URL",
        "AUXILIUMOS_TEST_PUBLISHABLE_KEY",
        "AUXILIUMOS_TEST_SERVICE_ROLE_KEY"
      ],
      "inputs": [
        "tests/api",
        "supabase/migrations",
        "docs/03-data/ADR-002-RUNTIME-FOUNDATION.md"
      ],
      "commands": [
        [
          "node",
          "--test",
          "tests/api/identity-directory.test.mjs"
        ]
      ]
    }
  ]
}
